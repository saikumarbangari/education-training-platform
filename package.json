{
  "name": "education-training-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "dev:local": "node server/scripts/dev-local.mjs",
    "dev:api": "node --watch server/index.js",
    "start:api": "node server/index.js",
    "start:hosted": "node server/start-hosted.js",
    "check:hosted": "node server/scripts/check-hosted.mjs",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser-smoke.mjs",
    "test:server": "node --test tests/server-logic.test.js tests/api-integration.test.js tests/learners-api.test.js",
    "format": "prettier --write src server tests vite.config.js package.json pnpm-workspace.yaml .github/workflows/deploy-pages.yml",
    "format:check": "prettier --check src server tests vite.config.js package.json pnpm-workspace.yaml .github/workflows/deploy-pages.yml",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "embedded-postgres": "18.4.0-beta.17",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "vite": "8.2.2"
  }
}
